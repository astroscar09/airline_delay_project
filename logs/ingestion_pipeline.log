        CREATE VIEW IF NOT EXISTS v_delay_causes_by_airline AS
        SELECT
            airline,
            COUNT(*) AS n_delayed_flights,
            AVG(carrier_delay) AS avg_carrier_delay,
            AVG(weather_delay) AS avg_weather_delay,
            AVG(nas_delay) AS avg_nas_delay,
